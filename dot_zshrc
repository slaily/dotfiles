# === Shell Options ===
set -o vi
unsetopt BEEP

bindkey -M viins 'jk' vi-cmd-mode

# Ctrl+Arrow word navigation
bindkey -M viins '^[[1;5D' backward-word
bindkey -M viins '^[[1;5C' forward-word
bindkey -M vicmd '^[[1;5D' backward-word
bindkey -M vicmd '^[[1;5C' forward-word

# === Environment & PATH ===
export GOPATH="$HOME/go"
export PATH="$PATH:$GOPATH/bin"

# Let starship handle the prompt; ignore venv prompt changes
export VIRTUAL_ENV_DISABLE_PROMPT=1

# === Homebrew ===
eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null || /usr/local/bin/brew shellenv)"

# === Mise ===
# Shims are instant; full shell integration loads on first `mise` invocation
export PATH="$HOME/.local/share/mise/shims:$PATH"
mise() {
  unset -f mise
  eval "$(command mise activate zsh)"
  mise "$@"
}

# === Atuin ===
# Lazy-load history search on first Ctrl+R
atuin-setup() {
  unset -f atuin-setup
  eval "$(atuin init zsh)"
  zle atuin-search
}
zle -N atuin-setup
bindkey '^R' atuin-setup

# === Plugins ===
if command -v brew &>/dev/null; then
  source "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

# === Aliases ===
[[ -f ~/.zsh_aliases ]] && source ~/.zsh_aliases

# === Prompt & navigation ===
eval "$(starship init zsh)"
eval "$(zoxide init zsh)"

# === SSH ===
# Only add the key if the agent has no identities yet
if ! ssh-add -l &>/dev/null; then
  ssh-add -q ~/.ssh/id_github &>/dev/null
fi

# === Completions ===
# -C skips the slow .zcompdump freshness check
autoload -Uz compinit
compinit -C

# === Auto virtualenv ===
auto_venv_activate() {
  local dir="$PWD" venv=""

  while [[ "$dir" != "/" ]]; do
    for name in .venv venv; do
      [[ -d "$dir/$name" ]] && venv="$dir/$name" && break 2
    done
    dir="${dir:h}"
  done

  if [[ -n "$venv" && "$VIRTUAL_ENV" != "$venv" ]]; then
    echo "🐍 Activated: ${venv/#$HOME/~}"
    source "$venv/bin/activate"
  elif [[ -z "$venv" && -n "$VIRTUAL_ENV" ]]; then
    echo "🚫 Deactivated: ${VIRTUAL_ENV/#$HOME/~}"
    deactivate
  fi
}

autoload -U add-zsh-hook
add-zsh-hook chpwd auto_venv_activate
add-zsh-hook precmd auto_venv_activate

# === Syntax highlighting (must be last) ===
if command -v brew &>/dev/null; then
  source "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
